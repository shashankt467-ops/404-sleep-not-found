# HC-04 Emergency Information Interoperability Gateway Configuration

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=postgresql://hc04_admin:EmergencySecurePass2026@localhost:5432/hc04_interop
# DATABASE_URL=sqlite:///./hc04.db

# Security & JWT Tokens
JWT_SECRET=hc04-production-super-secret-jwt-signing-key-2026-interop
JWT_REFRESH_SECRET=hc04-production-refresh-token-signing-key-2026-interop
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Healthcare Interoperability Endpoints (Ready for External Connection)
FHIR_BASE_URL=https://mock-hospital-fhir.hc04.internal/r4
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

HL7_ENDPOINT_HOST=127.0.0.1
HL7_ENDPOINT_PORT=2575

# Emergency Access Configuration
EMERGENCY_SESSION_DURATION_MINUTES=15

# Automatic Development Seed
AUTO_SEED=true
